#include <winres.h>

#include "Version.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

203 ICON "WebService.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION WEBSERVICE_VERSION
 PRODUCTVERSION WEBSERVICE_VERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            VALUE "CompanyName", "ROBLOX Corporation"
            VALUE "FileDescription", "ROBLOX Web Service"
            VALUE "FileVersion", WEBSERVICE_VERSION_STRING
            VALUE "InternalName", "WebService.exe"
            VALUE "LegalCopyright", "\xfd 2007 ROBLOX Corporation.  All rights reserved."
            VALUE "OriginalFilename", "WebService.exe"
            VALUE "ProductName", "ROBLOX"
            VALUE "ProductVersion", WEBSERVICE_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
